 "quiz": {
  "style": "CE",
  "banca": "estilo Cebraspe",
  "instructions": "Julgue os itens a seguir. No estilo Cebraspe, cada erro anula um acerto: na dúvida, deixe em branco.",
  "questions": [
   {
    "id": "q1",
    "answer": "C",
    "text": "A negação de “O agente dirigia e o escrivão anotava” é “O agente não dirigia ou o escrivão não anotava”.",
    "comment": "**Certo.** De Morgan."
   },
   {
    "id": "q2",
    "answer": "E",
    "text": "A negação de “Se o carro for roubado, o seguro pagará” é “Se o carro não for roubado, o seguro não pagará”.",
    "comment": "**Errado.** A negação é “O carro foi roubado e o seguro não pagará”."
   },
   {
    "id": "q3",
    "answer": "C",
    "text": "A negação de “Todo laudo é assinado por dois peritos” é “Algum laudo não é assinado por dois peritos”.",
    "comment": "**Certo.** Todo ↔ algum não."
   },
   {
    "id": "q4",
    "answer": "E",
    "text": "A negação de “Algum preso fugiu” é “Algum preso não fugiu”.",
    "comment": "**Errado.** A negação é “Nenhum preso fugiu”."
   },
   {
    "id": "q5",
    "answer": "C",
    "text": "A negação de P ∨ ¬Q é ¬P ∧ Q.",
    "comment": "**Certo.** De Morgan com dupla negação."
   },
   {
    "id": "q6",
    "answer": "C",
    "text": "A negação de P ↔ Q é equivalente a P ↔ ¬Q.",
    "comment": "**Certo.** Ambas são verdadeiras quando P e Q têm valores diferentes."
   },
   {
    "id": "q7",
    "answer": "E",
    "text": "A negação de “O réu é culpado” é “O réu é inocente”.",
    "comment": "**Errado.** A negação é “O réu não é culpado”; inocente seria o contrário."
   },
   {
    "id": "q8",
    "answer": "C",
    "text": "A negação de “Nenhum servidor faltou” é “Pelo menos um servidor faltou”.",
    "comment": "**Certo.** Nenhum ↔ algum."
   },
   {
    "id": "q9",
    "answer": "E",
    "text": "A negação de P ∧ ¬Q é ¬P ∧ Q.",
    "comment": "**Errado.** É ¬P ∨ Q."
   },
   {
    "id": "q10",
    "answer": "C",
    "text": "A negação de P → Q é equivalente a ¬(¬P ∨ Q).",
    "comment": "**Certo.** P → Q ⇔ ¬P ∨ Q; negar os dois lados mantém a equivalência."
   }
  ]
 },
